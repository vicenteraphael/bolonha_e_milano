@startuml casos-de-uso-etapa-4
title Bolonha e Milano — Casos de uso (Etapa 4)

' ---------- estilo ----------
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam ArrowColor #0B5C7A
skinparam actor {
  BorderColor #202859
  BackgroundColor #FFFFFF
  FontColor #202859
}
skinparam usecase {
  BackgroundColor #E8F0F4
  BorderColor #0B5C7A
  BorderThickness 2
  FontColor #202859
}
skinparam rectangle {
  BorderColor #202859
  BorderThickness 2
  FontColor #202859
}
left to right direction

actor Jogador

rectangle "Bolonha e Milano" {
  usecase "Iniciar novo jogo" as UC1
  usecase "Ver status da cidade" as UC2
  usecase "Acessar mercado" as UC3
  usecase "Acessar agricultura" as UC4 #FFF8EC;line:E8A33D
  usecase "Ver informações sobre o jogo" as UC5
  usecase "Sair do jogo" as UC6

  usecase "Comprar grãos" as UC31
  usecase "Vender grãos" as UC32
  usecase "Comprar terras" as UC33
  usecase "Vender terras" as UC34

  usecase "Colher (processar colheita)" as UC41 #FFF8EC;line:E8A33D
  usecase "Distribuir alimentos" as UC42 #FFF8EC;line:E8A33D
}

Jogador --> UC1
Jogador --> UC2
Jogador --> UC3
Jogador --> UC4
Jogador --> UC5
Jogador --> UC6

UC31 .> UC3 : <<extend>>
UC32 .> UC3 : <<extend>>
UC33 .> UC3 : <<extend>>
UC34 .> UC3 : <<extend>>
UC41 .> UC4 : <<extend>>
UC42 .> UC4 : <<extend>>

legend bottom
  Contorno âmbar = novo nesta etapa (Agricultura).
endlegend
@enduml
