/TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ encerrarAno(n: Nobreza): List&lt;Cidade&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ terminou(): bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ determinarVencedor(n: Nobreza): Cidade</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
  Cidade [shape=plain, label=<<TABLE BORDER="2" COLOR="#202859" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0"><TR><TD BGCOLOR="#202859" CELLPADDING="8"><FONT FACE="DejaVu Sans" COLOR="white" POINT-SIZE="15"><B>Cidade</B></FONT></TD></TR><TR><TD BGCOLOR="#F4F7FA" ALIGN="LEFT" CELLPADDING="7"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- ANO_INICIAL: int = 1400</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- FLORINS_INICIAIS: int = 1000</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- TERRAS_INICIAIS: int = 10000</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- GRAOS_INICIAIS: int = 500</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- SERVOS_INICIAIS: int = 200</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- TAXA_IMPOSTO_INICIAL: int = 10</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- NIVEL_JUSTICA_INICIAL: string = &quot;Moderada&quot;</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- SOLDADOS_INICIAIS: int = 0</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- CONSTRUCOES_INICIAIS: int = 0</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- nome: string {final}</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- anoAtual: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- dono: Jogador {final}</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- florins: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- terras: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- graos: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- servos: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- taxaImposto: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- nivelJustica: string</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- soldados: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- construcoes: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- colheitaFeita: bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- impostosArrecadados: bool</FONT></TD></TR></TABLE></TD></TR><TR><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ getNome() / getAnoAtual() / getDono()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ getFlorins() / getTerras()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ getGraos() / getServos()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ getSoldados() / getConstrucoes()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ getTaxaImposto() / setTaxaImposto(taxa)</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ getNivelJustica() / setNivelJustica(nivel)</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ avancarAno(): void  (zera os indicadores)</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ isColheitaFeita() / marcarColheitaFeita()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ isImpostosArrecadados() / marcarImpostosArrecadados()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ adicionarFlorins(qtd) / removerFlorins(qtd): bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ adicionarTerras(qtd) / removerTerras(qtd): bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ adicionarGraos(qtd) / removerGraos(qtd): bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ adicionarServos(qtd) / removerServos(qtd): bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ adicionarSoldados(qtd) / removerSoldados(qtd): bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ adicionarConstrucoes(qtd) / removerConstrucoes(qtd): bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ exibirStatus(): void</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
