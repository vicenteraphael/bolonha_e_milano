digraph G {
  graph [rankdir=TB, nodesep=1.1, ranksep=1.0, pad=0.4, bgcolor="white", splines=polyline,
         fontname="DejaVu Sans", labelloc=t, fontsize=22, fontcolor="#202859",
         label=<<B>Bolonha e Milano</B> · Diagrama de classes (Etapa 3)<BR/><FONT POINT-SIZE="12" COLOR="#5B6B82">Cumulativo: Etapas 1 a 3 · constantes sublinhadas = static final · linha tracejada = dependência (a Cidade chega por parâmetro)</FONT><BR/> >];
  node [fontname="DejaVu Sans"];
  edge [fontname="DejaVu Sans", fontsize=11, color="#202859", fontcolor="#202859", penwidth=1.4];

  Main [shape=plain, label=<<TABLE BORDER="2" COLOR="#202859" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0"><TR><TD BGCOLOR="#202859" CELLPADDING="8"><FONT FACE="DejaVu Sans" COLOR="white" POINT-SIZE="15"><B>Main</B></FONT></TD></TR><TR><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ main(): int</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
  Menu [shape=plain, label=<<TABLE BORDER="2" COLOR="#202859" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0"><TR><TD BGCOLOR="#202859" CELLPADDING="8"><FONT FACE="DejaVu Sans" COLOR="white" POINT-SIZE="15"><B>Menu</B></FONT></TD></TR><TR><TD BGCOLOR="#F4F7FA" ALIGN="LEFT" CELLPADDING="7"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- emExecucao: bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- jogador: Jogador</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- cidade: Cidade</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- mercado: Mercado {final}</FONT></TD></TR></TABLE></TD></TR><TR><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ executar(): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- exibirOpcoes(): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- lerOpcao(): int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- processarOpcao(opcao: int): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- iniciarNovoJogo(): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- exibirStatus(): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- exibirSobre(): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- abrirMercado(): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- lerQuantidade(): int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- comprarGraos() / venderGraos(): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- comprarTerras() / venderTerras(): void</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
  Mercado [shape=plain, label=<<TABLE BORDER="2" COLOR="#E8A33D" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0"><TR><TD BGCOLOR="#202859" CELLPADDING="8"><FONT FACE="DejaVu Sans" COLOR="white" POINT-SIZE="15"><B>Mercado</B></FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#E8A33D" POINT-SIZE="9"><B>NOVA NA ETAPA 3</B></FONT></TD></TR><TR><TD BGCOLOR="#F4F7FA" ALIGN="LEFT" CELLPADDING="7"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- PRECO_GRAO: int = 2</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- PRECO_TERRA: int = 1</U></FONT></TD></TR></TABLE></TD></TR><TR><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ getPrecoGrao(): int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ getPrecoTerra(): int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ comprarGraos(c: Cidade, qtd): bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ venderGraos(c: Cidade, qtd): bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ comprarTerras(c: Cidade, qtd): bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ venderTerras(c: Cidade, qtd): bool</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
  Cidade [shape=plain, label=<<TABLE BORDER="2" COLOR="#202859" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0"><TR><TD BGCOLOR="#202859" CELLPADDING="8"><FONT FACE="DejaVu Sans" COLOR="white" POINT-SIZE="15"><B>Cidade</B></FONT></TD></TR><TR><TD BGCOLOR="#F4F7FA" ALIGN="LEFT" CELLPADDING="7"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- ANO_INICIAL: int = 1400</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- FLORINS_INICIAIS: int = 1000</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- TERRAS_INICIAIS: int = 10000</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- GRAOS_INICIAIS: int = 500</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- nome: string {final}</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- anoAtual: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- dono: Jogador {final}</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- florins: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- terras: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- graos: int</FONT></TD></TR></TABLE></TD></TR><TR><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ getNome() / getAnoAtual() / getDono()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ getFlorins() / getTerras()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ getGraos(): int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ avancarAno(): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ adicionarFlorins(qtd) / removerFlorins(qtd): bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ adicionarTerras(qtd) / removerTerras(qtd): bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ adicionarGraos(qtd) / removerGraos(qtd): bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ exibirStatus(): void</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
  Jogador [shape=plain, label=<<TABLE BORDER="2" COLOR="#202859" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0"><TR><TD BGCOLOR="#202859" CELLPADDING="8"><FONT FACE="DejaVu Sans" COLOR="white" POINT-SIZE="15"><B>Jogador</B></FONT></TD></TR><TR><TD BGCOLOR="#F4F7FA" ALIGN="LEFT" CELLPADDING="7"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- nome: string {final}</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- titulo: string</FONT></TD></TR></TABLE></TD></TR><TR><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ getNome(): string</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ getTitulo(): string</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ setTitulo(titulo: string): void</FONT></TD></TR></TABLE></TD></TR></TABLE>>];

  Main -> Menu [arrowhead=vee, label="cria"];
  Menu -> Mercado     [arrowtail=diamond, dir=back, label="possui"];
  Menu -> Cidade      [arrowtail=diamond, dir=back, label="possui", constraint=false];
  Menu -> Jogador     [arrowtail=diamond, dir=back, label="possui", constraint=false];
  Mercado     -> Cidade [style=dashed, arrowhead=vee, color="#E8A33D", fontcolor="#B87A14", label="usa"];
  Cidade -> Jogador [arrowhead=vee, label="dono"];
  {rank=same; Main; Menu}
  {rank=same; Cidade; Jogador}
}