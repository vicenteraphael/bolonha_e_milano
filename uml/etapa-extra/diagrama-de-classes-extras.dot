  Partida [shape=plain, label=<<TABLE BORDER="2" COLOR="#E8A33D" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0"><TR><TD BGCOLOR="#202859" CELLPADDING="8"><FONT FACE="DejaVu Sans" COLOR="white" POINT-SIZE="15"><B>Partida</B></FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#E8A33D" POINT-SIZE="9"><B>ALTERADA NOS EXTRAS</B></FONT></TD></TR><TR><TD BGCOLOR="#F4F7FA" ALIGN="LEFT" CELLPADDING="7"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- MAXIMO_JOGADORES = 4</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- ANO_FINAL = 1410</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- jogadores: vector&lt;unique_ptr&lt;Jogador&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- cidades: vector&lt;unique_ptr&lt;Cidade&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- indiceAtual: size_t</FONT></TD></TR></TABLE></TD></TR><TR><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ adicionarCidade(j, c): bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ getCidades() / getCidadeAtual()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ getAnoAtual() / getAnoFinal()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ getMaximoJogadores(): int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ getIndiceAtual(): int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ restaurarVez(i): bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ passarTurno(): bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ encerrarAno(nobreza): vector&lt;Cidade*&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ terminou(): bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ determinarVencedor(nobreza): Cidade*</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
