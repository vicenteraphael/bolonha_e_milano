  Menu [shape=plain, label=<<TABLE BORDER="2" COLOR="#E8A33D" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0"><TR><TD BGCOLOR="#202859" CELLPADDING="8"><FONT FACE="DejaVu Sans" COLOR="white" POINT-SIZE="15"><B>Menu</B></FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#E8A33D" POINT-SIZE="9"><B>ALTERADA NOS EXTRAS</B></FONT></TD></TR><TR><TD BGCOLOR="#F4F7FA" ALIGN="LEFT" CELLPADDING="7"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- emExecucao: bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- partida: unique_ptr&lt;Partida&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- cidade: Cidade* (da vez)</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- mercado: Mercado {final}</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- agricultura: Agricultura {final}</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- governo: Governo {final}</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- construcoes: Construcoes {final}</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- nobreza: Nobreza {final}</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- persistencia: Persistencia {final}</FONT></TD></TR></TABLE></TD></TR><TR><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ executar(): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- exibirOpcoes() / lerOpcao() / processarOpcao()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- lerInteiro(prompt): int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- lerQuantidade(): int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- exigirJogoEmAndamento(): bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- iniciarNovoJogo() / exibirStatus()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- exibirSobre() / anunciarVez()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- abrirMercado() / abrirAgricultura()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- abrirGoverno() / abrirConstrucoes()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- comprarGraos() / venderGraos()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- comprarTerras() / venderTerras()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- colher() / distribuirAlimentos()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- arrecadarImpostos() / definirTaxaImposto()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- definirJustica()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- recrutarSoldados() / construir()</FONT></TD></TR><TR><TD