  Governo -> Cidade [style=dashed, arrowhead=vee, color="#2F6F6F", fontcolor="#2F6F6F"];
  Persistencia -> Partida [style=dashed, arrowhead=vee, color="#2F6F6F", fontcolor="#2F6F6F", xlabel="«cria»", constraint=false];
  Persistencia -> Governo [style=dashed, arrowhead=vee, color="#2F6F6F", fontcolor="#2F6F6F", xlabel="«valida com»", constraint=false];
