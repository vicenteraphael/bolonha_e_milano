  Nobreza [shape=plain, label=<<TABLE BORDER="2" COLOR="#202859" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0"><TR><TD BGCOLOR="#202859" CELLPADDING="8"><FONT FACE="DejaVu Sans" COLOR="white" POINT-SIZE="15"><B>Nobreza</B></FONT></TD></TR><TR><TD BGCOLOR="#F4F7FA" ALIGN="LEFT" CELLPADDING="7"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- PESO_CONSTRUCAO = 10</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- PESO_SOLDADO = 2</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- PESO_SERVO = 1</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- HECTARES_POR_PONTO = 100</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- PRESTIGIO_MINIMO[6] = {0,400,550,700,850,1000}</U></FONT></TD></TR></TABLE></TD></TR><TR><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ calcularPrestigio(c): int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ prestigioParaProximoTitulo(j): int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ verificarPromocao(c): bool</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
  Governo [shape=plain, label=<<TABLE BORDER="2" COLOR="#202859" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0"><TR><TD BGCOLOR="#202859" CELLPADDING="8"><FONT FACE="DejaVu Sans" COLOR="white" POINT-SIZE="15"><B>Governo</B></FONT></TD></TR><TR><TD BGCOLOR="#F4F7FA" ALIGN="LEFT" CELLPADDING="7"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- TAXA_MAXIMA = 50</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- MULTIPLICADOR_JUSTA = 0.8</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- MULTIPLICADOR_MODERADA = 1.0</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- MULTIPLICADOR_SEVERA = 1.3</U></FONT></TD></TR></TABLE></TD></TR><TR><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ arrecadarImpostos(c): int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ definirTaxaImposto(c, taxa): bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ definirJustica(c, nivel): bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ getTaxaMaxima(): int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- multiplicadorPara(nivel): double</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
  Persistencia [shape=plain, label=<<TABLE BORDER="2" COLOR="#E8A33D" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0"><TR><TD BGCOLOR="#202859" CELLPADDING="8"><FONT FACE="DejaVu Sans" COLOR="white" POINT-SIZE="15"><B>Persistencia</B></FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#E8A33D" POINT-SIZE="9"><B>NOVA NOS EXTRAS</B></FONT></TD></TR><TR><TD BGCOLOR="#F4F7FA" ALIGN="LEFT" CELLPADDING="7"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- CABECALHO: const char*</U></FONT></TD></TR></TABLE></TD></TR><TR><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ salvar(p, saida): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ carregar(entrada, erro): unique_ptr&lt;Partida&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ salvarArquivo(p, caminho, erro): bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ carregarArquivo(caminho, erro): unique_ptr&lt;Partida&gt;</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
  EstadoCidade [shape=plain, label=<<TABLE BORDER="2" COLOR="#E8A33D" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0"><TR><TD BGCOLOR="#202859" CELLPADDING="8"><FONT FACE="DejaVu Sans" COLOR="white" POINT-SIZE="15"><B>&#171;struct&#187; EstadoCidade</B></FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#E8A33D" POINT-SIZE="9"><B>NOVA NOS EXTRAS</B></FONT></TD></TR><TR><TD BGCOLOR="#F4F7FA" ALIGN="LEFT" CELLPADDING="7"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ ano: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ florins, terras, graos: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ servos, soldados, construcoes: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ colheitaFeita: bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ impostosArrecadados: bool</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
  Cidade [shape=plain, label=<<TABLE BORDER="2" COLOR="#E8A33D" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0"><TR><TD BGCOLOR="#202859" CELLPADDING="8"><FONT FACE="DejaVu Sans" COLOR="white" POINT-SIZE="15"><B>Cidade</B></FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#E8A33D" POINT-SIZE="9"><B>ALTERADA NOS EXTRAS</B></FONT></TD></TR><TR><TD BGCOLOR="#F4F7FA" ALIGN="LEFT" CELLPADDING="7"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- ANO_INICIAL = 1400</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- FLORINS_INICIAIS = 1000</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- TERRAS_INICIAIS = 10000</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- GRAOS_INICIAIS = 500</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- SERVOS_INICIAIS = 200</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- TAXA_IMPOSTO_INICIAL = 10</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- NIVEL_JUSTICA_INICIAL = &quot;Moderada&quot;</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- SOLDADOS_INICIAIS = 0</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- CONSTRUCOES_INICIAIS = 0</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- nome: string {final}</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- anoAtual: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- dono: Jogador* {final}</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- florins, terras, graos, servos: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- taxaImposto: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- nivelJustica: string</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- soldados, construcoes: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- colheitaFeita: bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- impostosArrecadados: bool</FONT></TD></TR></TABLE></TD></TR><TR><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ getX() de todos os atributos</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ setTaxaImposto(t) / setNivelJustica(n)</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ adicionarX(qtd): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ removerX(qtd): bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">    X = Florins, Terras, Graos, Servos,</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">        Soldados ou Construcoes</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ avancarAno(): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ isColheitaFeita() / marcarColheitaFeita()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ isImpostosArrecadados() / marcarImpostosArrecadados()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ getEstado(): EstadoCidade</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ restaurarEstado(e): bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ exibirStatus(): void</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
  Jogador [shape=plain, label=<<TABLE BORDER="2" COLOR="#202859" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0"><TR><TD BGCOLOR="#202859" CELLPADDING="8"><FONT FACE="DejaVu Sans" COLOR="white" POINT-SIZE="15"><B>Jogador</B></FONT></TD></TR><TR><TD BGCOLOR="#F4F7FA" ALIGN="LEFT" CELLPADDING="7"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- TITULOS: string[6]</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- nome: string {final}</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">- nivelTitulo: int</FONT></TD></TR></TABLE></TD></TR><TR><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ getNome(): string</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ getTitulo(): string</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ getNivelTitulo(): int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ promover(): bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236">+ ehMonarca(): bool</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
  Testes [shape=plain, label=<<TABLE BORDER="2" COLOR="#E8A33D" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0"><TR><TD BGCOLOR="#202859" CELLPADDING="8"><FONT FACE="DejaVu Sans" COLOR="white" POINT-SIZE="15"><B>Testes</B></FONT><BR/><FONT FACE="DejaVu Sans" COLOR="#E8A33D" POINT-SIZE="9"><B>ALTERADA NOS EXTRAS</B></FONT></TD></TR><TR><TD BGCOLOR="#F4F7FA" ALIGN="LEFT" CELLPADDING="7"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- aprovados: int</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- reprovados: int</U></FONT></TD></TR></TABLE></TD></TR><TR><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="7"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>+ executar(): int</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- verificar(descricao, condicao): void</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- novaCidade(): CidadeDeTeste</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- testarCidade() / testarMercado()</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- testarAgricultura() / testarGoverno()</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- testarConstrucoes()</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- testarJogadorENobreza() / testarPartida()</U></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#1B2236"><U>- testarPersistencia() / testarTerminal()</U></FONT></TD></TR></TABLE></TD></TR></TABLE>>];
  Legenda [shape=plain, label=<<TABLE BORDER="2" COLOR="#202859" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F4F7FA">
<TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#202859" POINT-SIZE="13"><B>Legenda</B></FONT></TD></TR>
<TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#202859"><B>Composição (losango cheio ◆):</B> o todo possui e destrói as partes. Ex.: Partida possui de 1 a 4 Cidades e Jogadores; o Menu possui a Partida e cada serviço.</FONT></TD></TR>
<TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#202859"><B>Agregação (losango vazado ◇):</B> o todo só referencia a parte, sem possuí-la. Ex.: o Menu aponta para a cidade da vez, que pertence à Partida.</FONT></TD></TR>
<TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#202859"><B>Associação (seta aberta →):</B> uma classe conhece a outra e navega até ela. Ex.: a Cidade conhece o seu Jogador dono.</FONT></TD></TR>
<TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#202859"><B>Dependência (tracejada ⇢):</B> uso passageiro, sem guardar referência. Ex.: os serviços recebem a Cidade como parâmetro.</FONT></TD></TR>
<TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#202859"><B>Cardinalidade:</B> 1 = exatamente um · 0..1 = nenhum ou um · 1..4 = de um a quatro · <B>{final}</B> = const, definido uma vez no construtor · sublinhado = static constexpr</FONT></TD></TR>
<TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#B87A14"><B>Borda âmbar</B> = classe nova ou alterada nos extras</FONT></TD></TR>
</TABLE>>];

