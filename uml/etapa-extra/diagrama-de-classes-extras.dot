digraph G {
  graph [rankdir=TB, nodesep=1.4, ranksep=1.1, pad=0.5, bgcolor="white", splines=ortho, newrank=true,
         fontname="DejaVu Sans", labelloc=t, fontsize=26, fontcolor="#202859",
         label=<<B>Bolonha e Milano</B> · Diagrama de classes (Etapa 8 + extras)<BR/><FONT POINT-SIZE="13" COLOR="#5B6B82">Cumulativo: Etapas 1 a 8 + extras (salvar/carregar, limpar tela, pausa, EstadoCidade) · sublinhado = static constexpr · borda âmbar = nova ou alterada nos extras</FONT><BR/> >];
