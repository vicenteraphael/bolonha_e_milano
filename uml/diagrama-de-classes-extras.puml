@startuml diagrama-de-classes-extras
title Bolonha e Milano — Diagrama de classes (Etapa 8 + extras)

' ---------- estilo ----------
skinparam shadowing false
skinparam roundCorner 0
skinparam defaultFontName DejaVu Sans
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 70
skinparam ranksep 60
skinparam ArrowColor #202859
skinparam ArrowFontColor #202859
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #202859
  BorderThickness 2
  HeaderBackgroundColor #202859
  FontColor #202859
  AttributeFontColor #1B2236
  AttributeFontName DejaVu Sans Mono
  AttributeFontSize 12
}
skinparam stereotypeCBackgroundColor #E8A33D
hide circle
hide empty members

' ---------- classes ----------
class Main {
  + main(): int
}

class Menu <<alterado nos extras>> #FFF8EC {
  - emExecucao: bool
  - partida: Partida
  - cidade: Cidade (da vez)
  - mercado: Mercado {readOnly}
  - agricultura: Agricultura {readOnly}
  - governo: Governo {readOnly}
  - persistencia: Persistencia {readOnly}
  - construcoes: Construcoes {readOnly}
  - nobreza: Nobreza {readOnly}
  --
  + executar(): void
  - exibirOpcoes(): void
  - lerOpcao(): int (chama lerInteiro)
  - lerInteiro(prompt): int
  - exigirJogoEmAndamento(): bool
  - processarOpcao(opcao: int): void
  - iniciarNovoJogo(): void (1 a 4 jogadores)
  - exibirStatus(): void
  - exibirSobre(): void
  - abrirMercado(): void
  - lerQuantidade(): int (chama lerInteiro)
  - comprarGraos() / venderGraos(): void
  - comprarTerras() / venderTerras(): void
  - abrirAgricultura(): void
  - colher(): void
  - distribuirAlimentos(): void
  - abrirGoverno(): void
  - arrecadarImpostos(): void
  - definirTaxaImposto(): void
  - definirJustica(): void
  - abrirConstrucoes(): void
  - recrutarSoldados(): void
  - construir(): void
  - encerrarTurno(): void
  - exibirClassificacao(): void
  - encerrarPartida(): void
  - anunciarVez(): void
  - salvarJogo() / carregarJogo(): void
  - lerNomeArquivo(caminho): bool
  - pausar(): void
}

class Jogador {
  - {static} TITULOS: string[6]
  - nome: string {readOnly}
  - nivelTitulo: int
  --
  + getNome(): string
  + getTitulo(): string
  + getNivelTitulo(): int
  + promover(): bool
  + ehMonarca(): bool
}

class Cidade {
  - {static} ANO_INICIAL: int = 1400
  - {static} FLORINS_INICIAIS: int = 1000
  - {static} TERRAS_INICIAIS: int = 10000
  - {static} GRAOS_INICIAIS: int = 500
  - {static} SERVOS_INICIAIS: int = 200
  - {static} TAXA_IMPOSTO_INICIAL: int = 10
  - {static} NIVEL_JUSTICA_INICIAL: string = "Moderada"
  - {static} SOLDADOS_INICIAIS: int = 0
  - {static} CONSTRUCOES_INICIAIS: int = 0
  - nome: string {readOnly}
  - anoAtual: int
  - dono: Jogador {readOnly}
  - florins: int
  - terras: int
  - graos: int
  - servos: int
  - taxaImposto: int
  - nivelJustica: string
  - soldados: int
  - construcoes: int
  - colheitaFeita: bool
  - impostosArrecadados: bool
  --
  + getNome() / getAnoAtual() / getDono()
  + getFlorins() / getTerras()
  + getGraos() / getServos()
  + getSoldados() / getConstrucoes()
  + getTaxaImposto() / setTaxaImposto(taxa)
  + getNivelJustica() / setNivelJustica(nivel)
  + avancarAno(): void (zera os indicadores)
  + getEstado(): EstadoCidade
  + restaurarEstado(e: EstadoCidade): bool
  + isColheitaFeita() / marcarColheitaFeita()
  + isImpostosArrecadados() / marcarImpostosArrecadados()
  + adicionarFlorins(qtd) / removerFlorins(qtd): bool
  + adicionarTerras(qtd) / removerTerras(qtd): bool
  + adicionarGraos(qtd) / removerGraos(qtd): bool
  + adicionarServos(qtd) / removerServos(qtd): bool
  + adicionarSoldados(qtd) / removerSoldados(qtd): bool
  + adicionarConstrucoes(qtd) / removerConstrucoes(qtd): bool
  + exibirStatus(): void
}

class Mercado {
  - {static} PRECO_GRAO: int = 2
  - {static} PRECO_TERRA: int = 1
  --
  + getPrecoGrao(): int
  + getPrecoTerra(): int
  + comprarGraos(c: Cidade, qtd): bool
  + venderGraos(c: Cidade, qtd): bool
  + comprarTerras(c: Cidade, qtd): bool
  + venderTerras(c: Cidade, qtd): bool
}

class Agricultura {
  - {static} HECTARES_POR_SERVO: int = 5
  - {static} RENDIMENTO_POR_HECTARE: int = 2
  - {static} SERVOS_POR_GRAO: int = 5
  - {static} CRESCIMENTO_PERCENTUAL: int = 5
  - {static} PERCENTUAL_MINIMO: int = 20
  - {static} PERCENTUAL_MAXIMO: int = 80
  --
  + processarColheita(c: Cidade): int (-1 se já colheu)
  + distribuirAlimentos(c: Cidade, %): bool
  + getPercentualMinimo(): int
  + getPercentualMaximo(): int
}

class Governo {
  - {static} TAXA_MAXIMA: int = 50
  - {static} MULTIPLICADOR_JUSTA: double = 0.8
  - {static} MULTIPLICADOR_MODERADA: double = 1.0
  - {static} MULTIPLICADOR_SEVERA: double = 1.3
  --
  + arrecadarImpostos(c: Cidade): int (-1 se já arrecadou)
  + definirTaxaImposto(c: Cidade, taxa): bool
  + definirJustica(c: Cidade, nivel): bool
  + getTaxaMaxima(): int
  - multiplicadorPara(nivel): double
}

class Construcoes {
  - {static} PRECO_SOLDADO: int = 5
  - {static} SERVOS_POR_SOLDADO: int = 1
  - {static} PRECO_CONSTRUCAO: int = 20
  --
  + recrutarSoldados(c: Cidade, qtd): bool
  + construir(c: Cidade, qtd): bool
  + getPrecoSoldado(): int
  + getPrecoConstrucao(): int
}

class Partida {
  - {static} MAXIMO_JOGADORES: int = 4
  - {static} ANO_FINAL: int = 1410
  - jogadores: List<Jogador>
  - cidades: List<Cidade>
  - indiceAtual: int
  --
  + adicionarCidade(j: Jogador, c: Cidade): bool
  + getCidades(): List<Cidade>
  + getCidadeAtual(): Cidade
  + getAnoAtual() / getAnoFinal(): int
  + getIndiceAtual(): int
  + restaurarVez(i: int): bool
  + passarTurno(): bool
  + encerrarAno(n: Nobreza): List<Cidade>
  + terminou(): bool
  + determinarVencedor(n: Nobreza): Cidade
}

class Nobreza {
  - {static} PESO_CONSTRUCAO: int = 10
  - {static} PESO_SOLDADO: int = 2
  - {static} PESO_SERVO: int = 1
  - {static} HECTARES_POR_PONTO: int = 100
  - {static} PRESTIGIO_MINIMO: int[6] = {0,400,550,700,850,1000}
  --
  + calcularPrestigio(c: Cidade): int
  + prestigioParaProximoTitulo(j: Jogador): int
  + verificarPromocao(c: Cidade): bool
}

class Testes <<nova na Etapa 8>> #FFF8EC {
  - {static} aprovados: int
  - {static} reprovados: int
  --
  + {static} executar(): int
  - {static} verificar(descricao, condicao): void
  - {static} novaCidade(): Cidade
  - {static} testarCidade() / testarMercado()
  - {static} testarAgricultura() / testarGoverno()
  - {static} testarConstrucoes()
  - {static} testarJogadorENobreza() / testarPartida()
  - {static} testarPersistencia() / testarTerminal()
}

class Terminal <<nova nos extras>> #FFF8EC {
  - {static} ativo: bool
  --
  + {static} setAtivo(valor: bool): void
  + {static} isAtivo(): bool
  + {static} limparTela(saida): void
  + {static} pausar(entrada, saida): bool
}

class Persistencia <<nova nos extras>> #FFF8EC {
  - {static} CABECALHO: string
  --
  + salvar(p: Partida, saida): void
  + carregar(entrada, erro): Partida
  + salvarArquivo(p: Partida, caminho, erro): bool
  + carregarArquivo(caminho, erro): Partida
}

class EstadoCidade <<struct>> #FFF8EC {
  + ano, florins, terras, graos: int
  + servos, soldados, construcoes: int
  + colheitaFeita, impostosArrecadados: bool
}

' ---------- relacionamentos ----------
Main ..> Menu : cria
Menu *-- Partida : possui
Menu ..> Cidade : vez atual
Menu *-- Mercado : possui
Menu *-- Agricultura : possui
Menu *-- Governo : possui
Menu *-- Construcoes : possui
Menu *-- Nobreza : possui
Menu *-- Persistencia : possui
Menu ..> Terminal : usa
Partida o-- "1..4" Cidade : guarda
Partida *-- "1..4" Jogador : possui
Cidade --> Jogador : dono
Mercado ..> Cidade : usa
Agricultura ..> Cidade : usa
Governo ..> Cidade : usa
Construcoes ..> Cidade : usa
Nobreza ..> Cidade : usa
Persistencia ..> Partida : usa
Persistencia ..> Governo : valida com
Cidade ..> EstadoCidade : foto
Testes ..> Partida : testa (todas as regras)

note bottom of Cidade
  Linha tracejada = dependência:
  a Cidade chega como parâmetro,
  os serviços nunca a guardam.
end note
@enduml
